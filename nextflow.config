
singularity {
  enabled = true
  autoMounts = true
}

process {
  withLabel: 'bcftools' { container = 'bcftools.1.19' }
  withLabel: 'penncnv'  { container = 'penncnv' }
  withLabel: 'cnvr'     { container = 'cnvr.0.1.0' }
}

params {
  type     = 'cnv,loh'
  features = 'gene,exon'

  // Optional steps
  adjust   = true
  filter   = true
  exclude  = true
  clean    = true
  export   = true
  heatmap  = true

  // gcm: cal_gc_snp
  numwindow = 100
  backgroundgc = 0.42

  // adjust: genomic_wave
  distance = 1000000

  // filter: filter_cnv
  numsnp   = 10
  maxnumsnp= 1000000
  length   = '50k'
  maxlength= '5000k'
  confidence = 1
  maxconfidence = 100
  qclrrsd  = 0.35
  qcnumcnv = 500
  qcbafdrift = 0.01
  qcwf = 0.05

  // clean: clean_cnv
  fraction = 0.2

  // plot: visualize_cnv
  format    = 'bed,tab'
  flank     = 1000
  n_samples = 10
  n_genes   = 10
}

profiles {
  // Resource profiles
  local     { includeConfig 'conf/local.config' }
  cluster   { includeConfig 'conf/cluster.config' }
  dynamic   { includeConfig 'conf/dynamic.config' }

  test {
    params {
      cohorts = "input/cohorts_info.csv"
    }
  }
}
