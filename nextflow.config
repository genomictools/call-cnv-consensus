
singularity {
  enabled = true
  autoMounts = true
}

process {
  withLabel: 'bcftools' { container = 'bcftools.1.19' }
  withLabel: 'penncnv'  { container = 'penncnv' }
}

params {
  type     = 'cnv,loh'
  features = 'gene,exon'

  adjust   = true
  qc       = true

  // gcm: cal_gc_snp
  numwindow = 100
  backgroundgc = 0.42

  // adjust: genomic_wave
  distance = 1000000

  // filter: filter_cnv
  numsnp   = 10
  maxnumsnp= 1000000
  length   = '50k'
  maxlength= '5000k'
  confidence = 1
  maxconfidence = 100

  // assess: filter_cnv
  qclrrsd  = 0.35
  qcnumcnv = 500

  // clean: clean_cnv
  fraction = 0.2
}

profiles {
  // Resource profiles
  local     { includeConfig 'conf/local.config' }
  cluster   { includeConfig 'conf/cluster.config' }
  dynamic   { includeConfig 'conf/dynamic.config' }

  test {
    params {
      cohorts = "input/cohorts_info.csv"
    }
  }
}
